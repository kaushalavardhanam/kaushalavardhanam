new file mode 100755
index 0000000..b97362d
--- /dev/null
+++ b/self-hosted-cloud-agent/agentcore/adapter/git-credential-github-env
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Git credential helper for AgentCore / Cursor self-hosted workers.
+# Reads a PAT or GitHub App token from the environment. Never prints it.
+set -eu
+token="${CURSOR_GIT_TOKEN:-${GH_TOKEN:-${GH_WORKER_TOKEN:-${GITHUB_TOKEN:-}}}}"
+cmd="${1:-}"
+if [ "$cmd" != "get" ]; then
+  exit 0
+fi
+host=""
+protocol=""
+while IFS= read -r line; do
+  [ -z "$line" ] && break
+  case "$line" in
+    host=*) host="${line#host=}" ;;
+    protocol=*) protocol="${line#protocol=}" ;;
+  esac
+done
+case "$host" in
+  github.com|*.github.com) ;;
+  *) exit 0 ;;
+esac
+if [ -z "$token" ]; then
+  exit 0
+fi
+printf 'protocol=%s\n' "${protocol:-https}"
+printf 'host=%s\n' "$host"
+printf 'username=x-access-token\n'
+printf 'password=%s\n' "$token"
